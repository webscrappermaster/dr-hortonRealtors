# ============================================================
# CLIENTE — visibles en el bundle JS (prefijo VITE_)
# ============================================================

# Número de respaldo para desarrollo local con npm run dev.
# En producción el número viene de /api/settings (Global Config).
# Solo dígitos, formato internacional sin "+".
# Ejemplo Colombia: 573001234567  |  Ejemplo EE.UU.: 14155551234
VITE_WHATSAPP_NUMBER=

# ============================================================
# SERVIDOR — NUNCA con prefijo VITE_, nunca en el bundle
# ============================================================

# Hash scrypt de la contraseña del admin.
# Generar con: node scripts/hash-password.js
ADMIN_PASSWORD_HASH=

# Clave para firmar cookies de sesión (mínimo 32 caracteres aleatorios).
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ---- Vercel Global Config (almacenamiento de ajustes) ----

# Cadena de conexión al store de Global Config.
# Vercel la inyecta automáticamente al conectar el store al proyecto.
GLOBAL_CONFIG=

# ID del store de Global Config (p. ej. gcfg_xxxxxxxxxxxx).
# Se encuentra en la URL del store en el dashboard de Vercel.
GLOBAL_CONFIG_ID=

# Token de acceso de Vercel con permisos de lectura/escritura en Global Config.
# Crear en: vercel.com → Account Settings → Tokens
VERCEL_ACCESS_TOKEN=

# ---- URL del sitio ----

# URL de producción (para validar el header Origin en escrituras).
# Ejemplo: https://mi-proyecto.vercel.app
SITE_URL=
