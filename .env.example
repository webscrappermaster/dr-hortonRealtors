# ============================================================
# CLIENTE — visibles en el bundle JS (prefijo VITE_)
# ============================================================

# Número de respaldo para desarrollo local con npm run dev.
# En producción el número viene de /api/settings (Global Config).
# Solo dígitos, formato internacional sin "+".
# Ejemplo Colombia: 573001234567  |  Ejemplo EE.UU.: 14155551234
VITE_WHATSAPP_NUMBER=

# ============================================================
# SERVIDOR — NUNCA con prefijo VITE_, nunca en el bundle
# ============================================================

# Hash scrypt de la contraseña del admin.
# Generar con: node scripts/hash-password.js
ADMIN_PASSWORD_HASH=

# Clave para firmar cookies de sesión (mínimo 32 caracteres aleatorios).
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ---- Vercel Edge Config (almacenamiento de ajustes) ----

# Cadena de conexión al store de Edge Config.
# Vercel la inyecta automáticamente al conectar el store al proyecto
# (Storage → Connect Store). Empieza con "edge-config://…".
GLOBAL_CONFIG=

# ID del store de Edge Config (formato: ecfg_xxxxxxxxxxxxxxxxxxxx).
# Se encuentra en: Storage → tu store → Settings → Edge Config ID.
GLOBAL_CONFIG_ID=

# Token de acceso de Vercel con permisos de lectura/escritura en Edge Config.
# Crear en: vercel.com → Account Settings → Tokens.
# IMPORTANTE: el scope debe ser "webscrapermaster → All Projects".
# Un token limitado a un proyecto específico no puede acceder al store.
VERCEL_ACCESS_TOKEN=

# ID del equipo de Vercel — OBLIGATORIO para que la API REST acepte escrituras.
# Encontrar en: vercel.com → Account Settings → General → Team ID (formato: team_xxxx).
# Tras agregar o cambiar cualquier variable, hacer Redeploy en Vercel.
VERCEL_TEAM_ID=

# ---- URL del sitio ----

# URL de producción (para validar el header Origin en escrituras).
# Ejemplo: https://mi-proyecto.vercel.app
SITE_URL=
